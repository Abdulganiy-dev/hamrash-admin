# Secrets for the media-upload and media-delete edge functions.
# Copy to secrets.env (git-ignored), fill in, then:
#   supabase secrets set --env-file supabase/functions/media-upload/secrets.env --project-ref ccvyhbyrtobdsecqvhcr
# Keep this file blank: a test fails if a value is pasted here (CLERK_JWKS_URL may stay, it's public).

# Cloudflare dashboard → right sidebar on the account overview
CLOUDFLARE_ACCOUNT_ID=
# API token with only Images: Edit and Stream: Edit
CLOUDFLARE_API_TOKEN=
# Images → Overview → "Account hash"
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
# Stream → the "customer-<code>" part of any video URL (bare code or full host both work)
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# Clerk → API keys → "JWKS URL", e.g. https://<your-app>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
# dev or prod: media ids are filed under it, and media-delete refuses the other environment's ids
MEDIA_ENV=
